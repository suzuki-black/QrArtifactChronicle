{
  "description": "extractYear regression corpus (docs/07 Q1). Both the TS oracle (extractYear) and the Rust core (extract_year) MUST reproduce `expected` exactly — this locks parity and guards against detection drift. `text: null` represents a binary / no-text QR. NOTE: extract_year only validates the plausible band 1970..=2099; the 'future → +0' rule lives in era_bonus_for (see units.rs era_bonus_boundaries_and_invalid), so e.g. 2050 is extracted here but yields eraBonus 0 downstream.",
  "cases": [
    { "desc": "vCard REV, ISO datetime", "text": "BEGIN:VCARD\nREV:2014-03-10T00:00:00Z\nEND:VCARD", "expected": 2014 },
    { "desc": "vCard REV, compact datetime", "text": "REV:20140310T101112Z", "expected": 2014 },
    { "desc": "vCard REV, compact date only", "text": "REV:20140310", "expected": 2014 },
    { "desc": "label is case-insensitive (lowercase rev)", "text": "rev:2014-03-10T00:00:00Z", "expected": 2014 },
    { "desc": "leading whitespace before label", "text": "   REV:2016-07-08T00:00:00Z", "expected": 2016 },
    { "desc": "iCal DTSTAMP compact", "text": "DTSTAMP:20081231T120000Z", "expected": 2008 },
    { "desc": "iCal DTSTART, compact date", "text": "DTSTART:19991231", "expected": 1999 },
    { "desc": "iCal DTSTART with VALUE param (semicolon)", "text": "DTSTART;VALUE=DATE:20200101", "expected": 2020 },
    { "desc": "VEVENT, multiple labels → newest wins", "text": "BEGIN:VEVENT\nDTSTART:20081231T000000Z\nDTSTAMP:20240101T000000Z\nEND:VEVENT", "expected": 2024 },
    { "desc": "URL unix timestamp, 10 digits (seconds)", "text": "https://t/x?t=1577836800", "expected": 2020 },
    { "desc": "URL unix timestamp, 13 digits (millis)", "text": "https://t/x?t=1577836800000", "expected": 2020 },
    { "desc": "URL unix timestamp, other seconds value", "text": "https://e.com/?ts=1234567890", "expected": 2009 },
    { "desc": "URL with ISO date in path (caught by ISO rule)", "text": "https://blog.example/2011-05-01/post", "expected": 2011 },
    { "desc": "standalone ISO 8601 date", "text": "2011-05-01", "expected": 2011 },
    { "desc": "ISO date embedded in free text", "text": "note 1985-06-15", "expected": 1985 },
    { "desc": "two ISO dates → newest year", "text": "1985-01-01 and 2003-05-05", "expected": 2003 },
    { "desc": "ISO lower boundary 1970", "text": "1970-01-01", "expected": 1970 },
    { "desc": "ISO upper boundary 2099", "text": "2099-12-31", "expected": 2099 },
    { "desc": "future-but-plausible (extracted; eraBonus handles future→0)", "text": "2050-01-01", "expected": 2050 },
    { "desc": "ISO preceded by a non-digit is fine", "text": "x2011-05-01", "expected": 2011 },

    { "desc": "binary / no-text QR", "text": null, "expected": null },
    { "desc": "empty string", "text": "", "expected": null },
    { "desc": "telephone number (digits are not a date)", "text": "tel:+81-3-1234-5678", "expected": null },
    { "desc": "bare 4-digit number (price) is not a year", "text": "price 1980 yen only", "expected": null },
    { "desc": "plain text, no date", "text": "plain text no date", "expected": null },
    { "desc": "Wi-Fi config has no date", "text": "WIFI:S:MyNet;T:WPA;P:secret;;", "expected": null },
    { "desc": "MeCard without a date", "text": "MECARD:N:Doe,John;TEL:0312345678;;", "expected": null },
    { "desc": "ISO with invalid month", "text": "2011-13-01", "expected": null },
    { "desc": "ISO with invalid day", "text": "2011-05-32", "expected": null },
    { "desc": "ambiguous 2-digit components, not YYYY-MM-DD", "text": "05-06-07", "expected": null },
    { "desc": "ISO immediately followed by a digit (not isolated)", "text": "2011-05-019", "expected": null },
    { "desc": "ISO immediately preceded by a digit (not isolated)", "text": "12011-05-01", "expected": null },
    { "desc": "URL number run of 11 digits is neither 10 nor 13", "text": "https://t/?t=12345678901", "expected": null },
    { "desc": "10-digit number outside a URL is not a timestamp", "text": "ref 1577836800 end", "expected": null },
    { "desc": "year above plausible band", "text": "2100-01-01", "expected": null },
    { "desc": "year below plausible band", "text": "1969-12-31", "expected": null }
  ]
}
